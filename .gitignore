# ============================================================================
# AUM GROUP INC. — Fine Jewellery & Gems
# Hostinger & Production Deployment .gitignore
# ============================================================================

# Environment variables & secrets
*.env
.env.*

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# Editor / IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files, backups & build archives
*.tmp
*.bak
*.backup
*.tar.gz
*.tgz
*.zip
*.rar
*.7z
AUM.tar.gz

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Scratch scripts & AI agent workspace artifacts
.gemini/
.agents/
.system_generated/
scratch/

# Node dependencies (if ever installed)
node_modules/
